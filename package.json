{
  "name": "my-calendar",
  "version": "1.0.0",
  "description": "Agenda pessoal responsiva feita com Bootstrap e Sass",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "sass": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import assets/scss/main.scss assets/css/main.css",
    "sass:watch": "sass --watch --load-path=node_modules --quiet-deps --silence-deprecation=import assets/scss/main.scss assets/css/main.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vinicius-L-Franca/my-calendar.git"
  },
  "keywords": [],
  "author": "Vinicius Liepienski de França",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Vinicius-L-Franca/my-calendar/issues"
  },
  "homepage": "https://github.com/Vinicius-L-Franca/my-calendar#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "jquery": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass": "^1.107.1"
  }
}
